# Supabase Configuration
# Get these from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Project ID (for type generation)
# Get from: https://app.supabase.com/projects - project settings
SUPABASE_PROJECT_ID=your_project_id_here

# Supabase Access Token (for CI/CD type generation and database management)
# Generate from: https://app.supabase.com/account/tokens
# CRITICAL: NEVER commit this token - use .env.local only
# Used in: yarn types:generate (CI/CD), supabase db push (migrations)
SUPABASE_ACCESS_TOKEN=your_access_token_here

# Database password (for admin operations)
# NEVER commit this file - use .env.local instead
# SUPABASE_PW=your_database_password_here

# E2E Test Credentials
# For running Playwright E2E tests, provide test user credentials
# Create a test user in your Supabase project and set these
# NOTE: NEVER commit real credentials - use .env.local for local testing
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your_test_password_here

# Integration Test Supabase (SEPARATE from production)
# Create a separate test Supabase project for integration tests
# This allows testing against real database without affecting production
TEST_SUPABASE_URL=https://test-project.supabase.co
TEST_SUPABASE_ANON_KEY=test_anon_key_here

# For different environments, create:
# .env.local (development)
# .env.test (testing with test Supabase project)
# .env.production (production Supabase project)
